    "network": [
      "good",
      "flaky",
      "offline"
    ],
    "basket": [
      "all in stock",
      "some out of stock",
      "price changed",
      "everything discontinued"
    ],
    "card": [
      "valid",
      "expired",
      "none"
    ],
    "slot": [
      "usual slot free",
      "usual slot full",
      "no slots today"
    ]
  },
  "hypotheses": [
    {
      "id": "H1",
      "text": "At least 60% of customers who open the sheet place the order.",
      "metric": "completion_rate",
      "op": ">=",
      "value": 0.6
    },
    {
      "id": "H2",
      "text": "At least 25% of all active customers use it.",
      "metric": "adoption_rate",
      "op": ">=",
      "value": 0.25
    },
    {
      "id": "H3",
      "text": "It takes under a minute.",
      "metric": "median_time_s",
      "op": "<=",
      "value": 60
    },
    {
      "id": "H4",
      "text": "At least 10% of new customers use it.",
      "metric": "adoption_rate",
      "segment": "new_customer",
      "op": ">=",
      "value": 0.1
    }
  ],
  "variants": [
    {
      "id": "usual-slot",
      "name": "Usual slot pre-selected",
      "note": "The slot step shows the customer's usual slot already chosen.",
      "patch": {
        "steps": {
          "pick_slot": {
            "effort": 0.1,
            "time_s": 5,
            "error_rate": 0.02
          }
        }
      }
    },
    {
      "id": "add-card",
      "name": "Add a card inline",
      "note": "Customers without a saved card can add one without leaving the flow.",
      "patch": {
        "add_steps": [
          {
            "id": "add_card",
            "name": "Adds a card",
            "type": "input",
            "effort": 0.6,
            "clarity": 0.7,
            "value": 0.4,
            "time_s": 45,
            "sensitive": true,
            "error_rate": 0.1,
            "on_error": {
              "recoverable": true
            },
            "grants": [
              "saved_card"
            ],
            "events": [
              "reorder_card_added"
            ],
            "next": [
              "confirm_pay"
            ]
          }
        ],
        "steps": {
          "confirm_pay": {
            "fallback": "add_card"
          }
        }
      }
    }
  ],
  "scenarios": [
    {
      "id": "fewer-saved-cards",
      "name": "Fewer customers have a saved card than we think",
      "note": "The saved-card shares are guesses from the payments team, not a query.",
      "patch": {
        "segments": {
          "weekly_regular": {
            "capabilities": {
              "saved_card": 0.7
            }
          },
          "occasional": {
            "capabilities": {
              "saved_card": 0.4
            }
          },
          "new_customer": {
            "capabilities": {
              "saved_card": 0.1
            }
          }
        }
      }
    },
    {
      "id": "banner-noticed",
      "name": "The home banner is noticed twice as often",
      "note": "If the banner gets the top slot for launch week.",
      "patch": {
        "entry_points": {
          "home_banner": {
            "discovery": 0.7
          }
        }
      }
    }
  ],
