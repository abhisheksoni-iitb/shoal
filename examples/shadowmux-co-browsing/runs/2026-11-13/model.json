          "linux": 0.25
        }
      },
      "capabilities": {
        "keychain_cookie_access": 0.25,
        "chrome_extension_installed": 0.3
      },
      "exposure": 0.85,
      "entry": {
        "agent_lease_request": 1.0
      }
    }
  ],
  "entry_points": [
    {
      "id": "agent_lease_request",
      "name": "Agent invokes ShadowMux lease API",
      "to": "acquire_lease",
      "discovery": 0.95
    }
  ],
  "steps": [
    {
      "id": "acquire_lease",
      "name": "Acquires atomic SQLite domain lease",
      "type": "external",
      "effort": 0.05,
      "clarity": 0.8,
      "value": 0.4,
      "time_s": 2,
      "error_rate": 0.03,
      "on_error": {
        "recoverable": true
      },
      "next": [
        {
          "to": "sync_cookies",
          "weight": 1.0
        }
      ],
      "events": [
        "lease_acquired"
      ],
      "handles": [
        "double_submit"
      ],
      "requires": [],
      "fallback": null,
      "optional": false,
      "observed_continue": null,
      "sensitive": false,
      "grants": []
    },
    {
      "id": "sync_cookies",
      "name": "Mirrors Chrome profile cookies & storage (OS Keychain)",
      "type": "external",
      "effort": 0.2,
      "clarity": 0.45,
      "value": 0.4,
      "time_s": 5,
      "error_rate": 0.07,
      "on_error": {
        "recoverable": true
      },
      "requires": [
        "keychain_cookie_access"
      ],
      "sensitive": true,
      "next": [
        {
          "to": "run_detached_task",
          "weight": 1.0
        }
      ],
      "events": [],
      "handles": [],
      "fallback": null,
      "optional": false,
      "observed_continue": null,
      "grants": []
    },
    {
      "id": "run_detached_task",
      "name": "Spawns Chrome at (-3200,-3200) & runs agent workflow",
      "type": "wait",
      "effort": 0.05,
      "clarity": 0.75,
      "value": 0.6,
      "time_s": 22,
      "error_rate": 0.06,
      "on_error": {
        "recoverable": true
      },
      "next": [
        {
          "to": "release_lease",
          "weight": 1.0,
          "when": {
            "human_overlap": "no_conflict"
          }
        },
        {
          "to": "conflict_sentinel_pause",
          "weight": 1.0,
          "when": {
            "human_overlap": "same_domain_active"
          }
        }
      ],
      "events": [
        "viewport_spawned"
      ],
      "handles": [
        "user_leaves"
      ],
      "requires": [],
      "fallback": null,
      "optional": false,
      "observed_continue": null,
      "sensitive": false,
      "grants": []
    },
    {
      "id": "conflict_sentinel_pause",
      "name": "Conflict Sentinel freezes agent & shows pause pill",
      "type": "view",
      "effort": 0.15,
      "clarity": 0.6,
      "value": 0.55,
      "time_s": 8,
      "requires": [
        "chrome_extension_installed"
      ],
      "next": [
        {
          "to": "arbitrate_handoff",
          "weight": 1.0
        }
      ],
      "events": [
        "conflict_detected"
      ],
      "handles": [],
      "error_rate": 0.0,
      "fallback": null,
      "on_error": null,
      "optional": false,
      "observed_continue": null,
      "sensitive": false,
      "grants": []
    },
    {
      "id": "arbitrate_handoff",
      "name": "Human finishes active tab & clicks Resume on pill",
      "type": "decision",
      "effort": 0.45,
      "clarity": 0.55,
      "value": 0.6,
      "time_s": 25,
      "next": [
        {
          "to": "release_lease",
          "weight": 1.0
        }
      ],
      "events": [],
      "handles": [],
      "error_rate": 0.0,
      "requires": [],
      "fallback": null,
      "on_error": null,
      "optional": false,
      "observed_continue": null,
      "sensitive": false,
      "grants": []
    },
    {
      "id": "release_lease",
      "name": "Releases SQLite lease & writes SHA-256 audit log",
      "type": "external",
      "effort": 0.05,
      "clarity": 0.85,
      "value": 0.8,
      "time_s": 2,
      "error_rate": 0.02,
      "next": [
        {
          "to": "task_completed",
          "weight": 1.0
        }
      ],
      "events": [
        "lease_released"
      ],
      "handles": [],
      "requires": [],
      "fallback": null,
      "on_error": null,
      "optional": false,
      "observed_continue": null,
      "sensitive": false,
      "grants": []
    },
    {
      "id": "task_completed",
      "name": "Background browser task finished with zero clobbering",
      "type": "success",
      "events": [
        "shadowmux_task_done"
      ],
      "handles": [
        "no_confirmation"
      ],
      "effort": 0.2,
      "clarity": 0.8,
      "value": 0.4,
      "time_s": 10,
      "error_rate": 0.0,
      "requires": [],
      "fallback": null,
      "next": [],
      "on_error": null,
      "optional": false,
      "observed_continue": null,
      "sensitive": false,
      "grants": []
    }
  ],
  "dimensions": {
    "human_overlap": [
      "no_conflict",
      "same_domain_active"
    ],
    "os": [
      "macos",
      "linux"
    ],
    "network": [
      "good",
      "flaky",
      "offline"
    ],
