  "entry_points": [
    {"id": "telegram_start", "name": "Telegram /start onboarding prompt", "to": "upload_resume", "discovery": 0.75},
    {"id": "cli_quickstart", "name": "README / Kiro CLI setup link", "to": "upload_resume", "discovery": 0.55}
  ],
  "steps": [
    {
      "id": "upload_resume",
      "name": "Uploads master resume (PDF/DOCX)",
      "type": "input",
      "effort": 0.65,
      "clarity": 0.70,
      "value": 0.30,
      "time_s": 35,
      "error_rate": 0.08,
      "on_error": {"recoverable": true},
      "requires": ["resume_file_ready"],
      "sensitive": true,
      "next": ["parse_bullets"],
      "events": ["resume_uploaded"],
      "handles": []
    },
    {
      "id": "parse_bullets",
      "name": "Docling parses & calibrates 28 bullets (110-118 chars)",
      "type": "wait",
      "effort": 0.05,
      "clarity": 0.65,
      "value": 0.45,
      "time_s": 14,
      "error_rate": 0.10,
      "on_error": {"recoverable": true},
      "next": ["verify_bullets"],
      "events": [],
      "handles": []
    },
    {
      "id": "verify_bullets",
      "name": "Reviews extracted bullets & approves verified facts",
      "type": "decision",
      "effort": 0.55,
      "clarity": 0.45,
      "value": 0.60,
      "time_s": 55,
      "next": ["set_vault_and_prefs"],
      "events": ["bullets_verified"],
      "handles": []
    },
    {
      "id": "set_vault_and_prefs",
      "name": "Sets AES-256 passphrase & target role/comp preferences",
      "type": "input",
      "effort": 0.50,
      "clarity": 0.55,
      "value": 0.50,
      "time_s": 40,
      "error_rate": 0.05,
      "on_error": {"recoverable": true},
      "sensitive": true,
      "next": ["vault_armed"],
      "events": ["vault_sealed"],
      "handles": []
    },
    {
      "id": "vault_armed",
      "name": "Vault locked & 09:00 AM daily loop scheduled",
      "type": "success",
      "events": ["onboarding_completed"],
      "handles": ["no_confirmation"]
    }
  ],
  "dimensions": {
    "device": ["desktop", "mobile"],
    "network": ["good", "flaky", "offline"],
    "resume_format": ["clean_single_col", "two_col_canva"],
    "bullet_count": ["15-28 clean bullets", "<15 bullets (junior)", "40+ bullets (multi-page CV)"]
  },
  "hypotheses": [
    {
      "id": "H1",
      "text": "Activation: at least 75% of users who start onboarding finish verifying their vault.",
      "metric": "completion_rate",
      "op": ">=",
      "value": 0.75
    },
    {
      "id": "H2",
      "text": "Onboarding completes in 3 minutes (180s) or less.",
      "metric": "median_time_s",
      "op": "<=",
      "value": 180
    },
    {
      "id": "H3",
      "text": "Mobile Telegram seekers activate at least 50% of the time.",
      "metric": "completion_rate",
      "op": ">=",
      "value": 0.50,
      "segment": "mobile_telegram_seeker"
    }
  ],
  "variants": [
    {
      "id": "linkedin-or-paste-fallback",
      "name": "Allow pasting resume text or LinkedIn URL when PDF is not on phone",
      "note": "Instead of requiring a local PDF upload on mobile, accept pasted text or LinkedIn profile import.",
      "patch": {
        "steps": {
          "upload_resume": {"fallback": "paste_text_or_link", "effort": 0.40}
        },
        "add_steps": [
          {
            "id": "paste_text_or_link",
            "name": "Pastes LinkedIn URL or summary text instead of PDF",
            "type": "input",
            "effort": 0.35,
            "clarity": 0.75,
            "value": 0.45,
            "time_s": 25,
            "grants": ["resume_file_ready"],
            "next": ["parse_bullets"],
            "events": ["resume_text_submitted"],
            "handles": []
          }
        ]
      }
    },
    {
      "id": "inline-bullet-edit",
      "name": "Grouped verification + per-bullet tap-to-edit",
      "note": "Show extracted skills/metrics grouped by role with quick tap-to-fix instead of a 28-bullet wall of text.",
      "patch": {
        "steps": {
          "verify_bullets": {"effort": 0.35, "clarity": 0.72, "time_s": 30}
        }
      }
    }
  ]
}
