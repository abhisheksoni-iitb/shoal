  "hypotheses": [
    {
      "id": "H1",
      "text": "Daily Engagement: at least 85% of eligible candidates open and review the 09:00 AM Telegram card.",
      "metric": "discovery_rate",
      "op": ">=",
      "value": 0.85
    },
    {
      "id": "H2",
      "text": "Application Confirmation Rate: at least 40% of candidates who open a card finish applying.",
      "metric": "completion_rate",
      "op": ">=",
      "value": 0.40
    },
    {
      "id": "H3",
      "text": "Execution Cycle Time: median time from opening the card to stamped receipt is 45 seconds or less.",
      "metric": "median_time_s",
      "op": "<=",
      "value": 45
    },
    {
      "id": "H4",
      "text": "Trust threshold: at least half of candidates who reach 1-Tap Apply proceed to submit.",
      "metric": "step_continue:confirm_1tap_apply",
      "op": ">=",
      "value": 0.50
    }
  ],
  "variants": [
    {
      "id": "queued-desktop-relay",
      "name": "Queue application when desktop ShadowMux is asleep",
      "note": "Instead of blocking mobile commuters whose laptop is closed, queue the 1-tap apply request and run it automatically when ShadowMux reconnects.",
      "patch": {
        "steps": {
          "acquire_shadowmux": {"fallback": "queue_until_online"}
        },
        "add_steps": [
          {
            "id": "queue_until_online",
            "name": "Queues apply job until desktop ShadowMux reconnects",
            "type": "wait",
            "effort": 0.15,
            "clarity": 0.70,
            "value": 0.55,
            "time_s": 12,
            "error_rate": 0.05,
            "on_error": {"recoverable": true},
            "grants": ["shadowmux_online"],
            "next": ["acquire_shadowmux"],
            "events": ["apply_queued"],
            "handles": ["user_leaves"]
          }
        ]
      }
    },
    {
      "id": "inline-bullet-review",
      "name": "Show tailored bullets & custom answers before 1-Tap Apply",
      "note": "Include a compact summary of the 6 selected bullets and pre-filled EEO/custom answers under the card so cautious engineers trust what will be submitted.",
