      "context": {"device": {"desktop": 0.7, "mobile": 0.3}, "network": {"good": 0.9, "flaky": 0.1}},
      "capabilities": {"account_set_up": 0.95},
      "exposure": 1.0,
      "entry": {"main_entry": 1.0}
    },
    {
      "id": "casual_user",
      "name": "Casual user",
      "share": 0.4,
      "traits": {"motivation": 0.45, "skill": 0.45, "patience": 0.45, "trust": 0.55},
      "context": {"device": {"desktop": 0.4, "mobile": 0.6}, "network": {"good": 0.8, "flaky": 0.2}},
