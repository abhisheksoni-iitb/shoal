    {"id": "done", "name": "Done", "type": "success", "time_s": 3, "events": ["feature_completed"]}
  ],
  "dimensions": {
    "network": ["good", "flaky", "offline"],
    "device": ["desktop", "mobile"],
    "account_state": ["new", "established", "suspended"]
  },
  "hypotheses": [
    {"id": "H1", "text": "At least half of the people who start will finish.", "metric": "completion_rate", "op": ">=", "value": 0.5}
